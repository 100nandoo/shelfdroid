DROP TABLE PodcastEpisodeEntity;

CREATE TABLE PodcastEpisodeEntity (
  id TEXT PRIMARY KEY NOT NULL,
  libraryItemId TEXT NOT NULL,
  episodeIndex INTEGER,
  season TEXT,
  episode TEXT,
  episodeType TEXT,
  title TEXT NOT NULL,
  subtitle TEXT,
  description TEXT,
  enclosureUrl TEXT,
  enclosureType TEXT,
  enclosureLength TEXT,
  pubDate TEXT,
  audioFileIndex INTEGER NOT NULL,
  audioFileIno TEXT NOT NULL,
  audioFileFilename TEXT NOT NULL,
  audioFileExt TEXT NOT NULL,
  audioFilePath TEXT NOT NULL,
  audioFileRelPath TEXT NOT NULL,
  audioFileSize INTEGER NOT NULL,
  audioFileMtimeMs INTEGER NOT NULL,
  audioFileCtimeMs INTEGER NOT NULL,
  audioFileBirthtimeMs INTEGER NOT NULL,
  audioFileAddedAt INTEGER NOT NULL,
  audioFileUpdatedAt INTEGER NOT NULL,
  audioFileTrackNumFromMeta INTEGER,
  audioFileDiscNumFromMeta INTEGER,
  audioFileTrackNumFromFilename INTEGER,
  audioFileDiscNumFromFilename INTEGER,
  audioFileManuallyVerified INTEGER NOT NULL,
  audioFileExcluded INTEGER NOT NULL,
  audioFileError TEXT,
  audioFileFormat TEXT NOT NULL,
  audioFileDuration REAL NOT NULL,
  audioFileBitRate INTEGER NOT NULL,
  audioFileLanguage TEXT,
  audioFileCodec TEXT NOT NULL,
  audioFileTimeBase TEXT NOT NULL,
  audioFileChannels INTEGER NOT NULL,
  audioFileChannelLayout TEXT NOT NULL,
  audioFileEmbeddedCoverArt TEXT,
  audioFileMimeType TEXT NOT NULL,
  audioTrackIndex INTEGER NOT NULL,
  audioTrackIno TEXT NOT NULL,
  audioTrackFilename TEXT NOT NULL,
  audioTrackExt TEXT NOT NULL,
  audioTrackPath TEXT NOT NULL,
  audioTrackRelPath TEXT NOT NULL,
  audioTrackSize INTEGER NOT NULL,
  audioTrackMtimeMs INTEGER NOT NULL,
  audioTrackCtimeMs INTEGER NOT NULL,
  audioTrackBirthtimeMs INTEGER NOT NULL,
  audioTrackAddedAt INTEGER NOT NULL,
  audioTrackUpdatedAt INTEGER NOT NULL,
  audioTrackDiscNumFromFilename INTEGER NOT NULL,
  audioTrackManuallyVerified INTEGER NOT NULL,
  audioTrackExcluded INTEGER NOT NULL,
  audioTrackFormat TEXT NOT NULL,
  audioTrackDuration REAL NOT NULL,
  audioTrackBitRate INTEGER NOT NULL,
  audioTrackCodec TEXT NOT NULL,
  audioTrackTimeBase TEXT NOT NULL,
  audioTrackChannels INTEGER NOT NULL,
  audioTrackChannelLayout TEXT NOT NULL,
  audioTrackMimeType TEXT NOT NULL,
  audioTrackTitle TEXT NOT NULL,
  audioTrackStartOffset REAL NOT NULL,
  audioTrackContentUrl TEXT NOT NULL,
  publishedAt INTEGER,
  addedAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

CREATE INDEX PodcastEpisodeEntity_libraryItemId
ON PodcastEpisodeEntity(libraryItemId);
