UPDATE LibraryItemEntity
SET media = ''
WHERE isBook = 1;

CREATE TABLE BookEntity (
  libraryItemId TEXT PRIMARY KEY NOT NULL,
  coverPath TEXT,
  title TEXT,
  language TEXT,
  explicit INTEGER NOT NULL,
  description TEXT,
  subtitle TEXT,
  publishedYear TEXT,
  publishedDate TEXT,
  publisher TEXT,
  isbn TEXT,
  asin TEXT,
  descriptionPlain TEXT,
  duration REAL,
  ebookIno TEXT,
  ebookFilename TEXT,
  ebookExt TEXT,
  ebookPath TEXT,
  ebookRelPath TEXT,
  ebookSize INTEGER,
  ebookMtimeMs INTEGER,
  ebookCtimeMs INTEGER,
  ebookBirthtimeMs INTEGER,
  ebookFormat TEXT,
  ebookAddedAt INTEGER,
  ebookUpdatedAt INTEGER
);
