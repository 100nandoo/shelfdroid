DELETE FROM LibraryItemEntity
WHERE isBook = 0;

UPDATE LibraryItemEntity
SET media = ''
WHERE isBook = 1;

CREATE TABLE BookEntity (
  libraryItemId TEXT PRIMARY KEY NOT NULL,
  coverPath TEXT,
  title TEXT,
  language TEXT,
  explicit INTEGER NOT NULL,
  description TEXT,
  subtitle TEXT,
  publishedYear TEXT,
  publishedDate TEXT,
  publisher TEXT,
  isbn TEXT,
  asin TEXT,
  descriptionPlain TEXT,
  duration REAL,
  ebookIno TEXT,
  ebookFilename TEXT,
  ebookExt TEXT,
  ebookPath TEXT,
  ebookRelPath TEXT,
  ebookSize INTEGER,
  ebookMtimeMs INTEGER,
  ebookCtimeMs INTEGER,
  ebookBirthtimeMs INTEGER,
  ebookFormat TEXT,
  ebookAddedAt INTEGER,
  ebookUpdatedAt INTEGER
);

CREATE TABLE PodcastEpisodeEntity (
  id TEXT PRIMARY KEY NOT NULL,
  libraryItemId TEXT NOT NULL,
  episodeIndex INTEGER,
  season TEXT,
  episode TEXT,
  episodeType TEXT,
  title TEXT NOT NULL,
  subtitle TEXT,
  description TEXT,
  enclosureUrl TEXT,
  enclosureType TEXT,
  enclosureLength TEXT,
  pubDate TEXT,
  audioFile TEXT NOT NULL,
  audioTrack TEXT NOT NULL,
  publishedAt INTEGER,
  addedAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

CREATE INDEX PodcastEpisodeEntity_libraryItemId
ON PodcastEpisodeEntity(libraryItemId);

CREATE TABLE PodcastEntity (
  libraryItemId TEXT PRIMARY KEY NOT NULL,
  media TEXT NOT NULL
);
