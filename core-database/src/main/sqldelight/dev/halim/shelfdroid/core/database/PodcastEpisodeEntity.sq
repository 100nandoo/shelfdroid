CREATE TABLE PodcastEpisodeEntity (
  id TEXT PRIMARY KEY NOT NULL,
  libraryItemId TEXT NOT NULL,
  episodeIndex INTEGER,
  season TEXT,
  episode TEXT,
  episodeType TEXT,
  title TEXT NOT NULL,
  subtitle TEXT,
  description TEXT,
  enclosureUrl TEXT,
  enclosureType TEXT,
  enclosureLength TEXT,
  pubDate TEXT,
  audioFile TEXT NOT NULL,
  audioTrack TEXT NOT NULL,
  publishedAt INTEGER,
  addedAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

CREATE INDEX PodcastEpisodeEntity_libraryItemId
ON PodcastEpisodeEntity(libraryItemId);

byId:
SELECT *
FROM PodcastEpisodeEntity
WHERE id = :id;

byLibraryItemId:
SELECT *
FROM PodcastEpisodeEntity
WHERE libraryItemId = :libraryItemId;

insert:
INSERT OR REPLACE INTO PodcastEpisodeEntity VALUES ?;

deleteByLibraryItemId:
DELETE FROM PodcastEpisodeEntity
WHERE libraryItemId = :libraryItemId;

deleteByIds:
DELETE FROM PodcastEpisodeEntity
WHERE id IN :ids;
