CREATE TABLE LibraryEntity(
  id TEXT PRIMARY KEY NOT NULL,
  name TEXT NOT NULL DEFAULT '',
  folders TEXT NOT NULL,
  isBookLibrary INTEGER NOT NULL DEFAULT 1,
  displayOrder INTEGER NOT NULL DEFAULT 0,
  icon TEXT NOT NULL DEFAULT 'audiobookshelf'
);

all:
SELECT * FROM LibraryEntity
ORDER BY displayOrder ASC, id ASC;

allIds:
SELECT id FROM LibraryEntity
ORDER BY displayOrder ASC, id ASC;

byId:
SELECT *
FROM LibraryEntity
WHERE id = :id;

insert:
INSERT OR REPLACE INTO LibraryEntity(id, name, folders, isBookLibrary, displayOrder, icon)
VALUES ?;

deleteById:
DELETE FROM LibraryEntity WHERE id = ?;

deleteAll:
DELETE FROM LibraryEntity;
