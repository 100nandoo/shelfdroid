CREATE TABLE LibraryItemEntity (
  id TEXT PRIMARY KEY NOT NULL,
  libraryId TEXT NOT NULL,
  author TEXT NOT NULL DEFAULT '',
  authorFirstLast TEXT NOT NULL DEFAULT '',
  authorLastFirst TEXT NOT NULL DEFAULT '',
  title TEXT NOT NULL DEFAULT '',
  description TEXT NOT NULL DEFAULT '',
  cover TEXT NOT NULL DEFAULT '',
  updatedAt INTEGER NOT NULL DEFAULT 0,
  rssFeed TEXT,
  isBook INTEGER NOT NULL DEFAULT 1,
  inoId TEXT NOT NULL DEFAULT '',
  duration REAL NOT NULL DEFAULT 0,
  addedAt INTEGER NOT NULL
);

all:
SELECT * FROM LibraryItemEntity;

libraryItemCatalog:
SELECT
  id,
  libraryId,
  author,
  authorFirstLast,
  authorLastFirst,
  title,
  cover,
  duration,
  isBook,
  addedAt,
  (
    SELECT COUNT(*)
    FROM PodcastEpisodeEntity
    WHERE PodcastEpisodeEntity.libraryItemId = LibraryItemEntity.id
  ) AS episodeCount
FROM LibraryItemEntity;

idsByLibraryId:
SELECT id
FROM LibraryItemEntity
WHERE libraryId = :libraryId;

byLibraryId:
SELECT *
FROM LibraryItemEntity
WHERE libraryId = :libraryId;

byId:
SELECT *
FROM LibraryItemEntity
WHERE id = :id;

insert:
INSERT OR REPLACE INTO LibraryItemEntity(id, libraryId, author, authorFirstLast, authorLastFirst, title, description, cover, updatedAt, rssFeed, isBook, inoId, duration, addedAt)
VALUES ?;

deleteById:
DELETE FROM LibraryItemEntity WHERE id = ?;

deleteAll:
DELETE FROM LibraryItemEntity;

podcasts:
SELECT * FROM LibraryItemEntity WHERE isBook = 0;

podcastsByLibraryId:
SELECT *
FROM LibraryItemEntity
WHERE isBook = 0
  AND libraryId = :libraryId;
