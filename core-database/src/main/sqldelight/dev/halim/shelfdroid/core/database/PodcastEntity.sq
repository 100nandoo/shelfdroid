CREATE TABLE PodcastEntity (
  libraryItemId TEXT PRIMARY KEY NOT NULL,
  media TEXT NOT NULL
);

byLibraryItemId:
SELECT *
FROM PodcastEntity
WHERE libraryItemId = :libraryItemId;

insert:
INSERT OR REPLACE INTO PodcastEntity VALUES ?;

deleteByLibraryItemId:
DELETE FROM PodcastEntity
WHERE libraryItemId = :libraryItemId;
