<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="110dp"
    android:background="@drawable/playback_widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/playback_widget_brand_description"
        android:src="@drawable/widget_brand_headphones"
        android:tint="@color/playback_widget_preview_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/playback_widget_empty_title"
            android:textColor="@color/playback_widget_preview_foreground"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans"
            android:maxLines="2"
            android:text="@string/playback_widget_empty_expanded_message"
            android:textColor="@color/playback_widget_preview_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
